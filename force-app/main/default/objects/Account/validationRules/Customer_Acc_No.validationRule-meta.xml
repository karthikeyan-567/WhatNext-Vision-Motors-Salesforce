<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Customer_Acc_No</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISBLANK(AccountNumber),
ISPICKVAL(Ownership,&apos;Public&apos;)
)</errorConditionFormula>
    <errorMessage>You must need to enter the account number When Ownership is Public</errorMessage>
</ValidationRule>
